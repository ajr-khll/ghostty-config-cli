{
  "name": "ghostty-config-cli",
  "version": "0.1.0",
  "description": "A fullscreen terminal UI for editing your Ghostty config, with live preview. Cross-platform (macOS + Linux).",
  "type": "module",
  "bin": {
    "ghostty-config-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ghostty",
    "terminal",
    "config",
    "tui",
    "ink",
    "cli",
    "theme",
    "editor"
  ],
  "author": "aj khullar <arjunkhullar2006@gmail.com>",
  "license": "MIT",
  "engineStrict": false,
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "execa": "^9.5.1",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
